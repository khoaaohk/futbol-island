# Copy to .env.local and fill in. Never commit real values.

# football-data.org v4 API token (free tier: register at https://www.football-data.org/client/register).
# Server only: used by lib/town/footballDataServer.ts for NPC match scores. Do not rename it to NEXT_PUBLIC_*.
# Without it, scores fall back to ESPN (which returns HTTP 403 from Vercel). See docs/product-decisions.md.
FOOTBALL_DATA_TOKEN=

# Multiplayer (Phase 0, flag stays off by default). Uncomment only to test locally.
# NEXT_PUBLIC_MULTIPLAYER=
# NEXT_PUBLIC_MULTIPLAYER_URL=
